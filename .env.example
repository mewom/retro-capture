# === Storage ===
# With AWS credentials set, videos upload directly to S3 via presigned URLs.
# Leave them blank to run in LOCAL mode (files written to ./uploads) - useful
# for testing without an AWS account. Local files do NOT survive a Render redeploy.

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=retro-capture-videos

# Force a storage backend instead of auto-detecting: s3 | local
# STORAGE_MODE=local
# LOCAL_UPLOAD_DIR=./uploads

# === Session security ===
# Fixed 4-digit PIN every phone must enter. If unset, a PIN is generated per
# session and displayed on the conductor phone.
# SESSION_PIN=1234

# How long the conductor keeps its role after a disconnect (screen lock, WiFi
# blip) before another phone is promoted. Milliseconds.
# CONDUCTOR_GRACE_MS=30000

# === Server ===
PORT=3000
